{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "rsm-emlak",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rsm-emlak-db",
      "migrations_dir": "migrations"
    }
  ]
}